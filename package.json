{
  "name": "@lizzelabs/react-harmony",
  "private": false,
  "version": "2.1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://lizzelabs.github.io/react-harmony/",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.es.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.es.js",
      "require": "./dist/components.es.js",
      "types": "./dist/components/index.d.ts"
    },
    "./systems": {
      "import": "./dist/systems.es.js",
      "require": "./dist/systems.es.js",
      "types": "./dist/components/piece-provider/static.d.ts"
    },
    "./types": {
      "import": "./dist/types.es.js",
      "require": "./dist/types.es.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.es.js",
      "require": "./dist/utils.es.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./piece": {
      "import": "./dist/piece.es.js",
      "require": "./dist/piece.es.js",
      "types": "./dist/components/piece/index.d.ts"
    },
    "./piece-provider": {
      "import": "./dist/piece-provider.es.js",
      "require": "./dist/piece-provider.es.js",
      "types": "./dist/components/piece-provider/index.d.ts"
    },
    "./screen": {
      "import": "./dist/screen.es.js",
      "require": "./dist/screen.es.js",
      "types": "./dist/components/screen/index.d.ts"
    },
    "./scrollable": {
      "import": "./dist/scrollable.es.js",
      "require": "./dist/scrollable.es.js",
      "types": "./dist/components/scrollable/index.d.ts"
    },
    "./text": {
      "import": "./dist/text.es.js",
      "require": "./dist/text.es.js",
      "types": "./dist/components/text/text.d.ts"
    },
    "./media": {
      "import": "./dist/media.es.js",
      "require": "./dist/media.es.js",
      "types": "./dist/components/media/index.d.ts"
    },
    "./animations": {
      "import": "./dist/animations.es.js",
      "require": "./dist/animations.es.js",
      "types": "./dist/components/animations/index.d.ts"
    },
    "./hocs": {
      "import": "./dist/hocs.es.js",
      "require": "./dist/hocs.es.js",
      "types": "./dist/hocs/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "development": "nodemon",
    "build:dev": "vite build --config vite.config.development.ts",
    "build:prd": "vite build --config vite.config.release.ts",
    "test": "vitest --config vite.config.test.ts",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint --type-aware --fix src/",
    "format": "oxfmt",
    "prepare": "husky",
    "postinstall": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@ttsc/unplugin": "^0.16.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript/typescript6": "^6.0.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "csstype": "^3.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.60.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ttsc": "^0.16.7",
    "typescript": "7.0.1-rc",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@9.15.2+sha512.93e57b0126f0df74ce6bff29680394c0ba54ec47246b9cf321f0121d8d9bb03f750a705f24edc3c1180853afd7c2c3b94196d0a3d53d3e069d9e2793ef11f321",
  "peerDependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "dependencies": {
    "lodash": "^4.17.23",
    "stylis": "^4.3.6"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin"
      ],
      "cpu": [
        "arm64"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ]
  }
}
